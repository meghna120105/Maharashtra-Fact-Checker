# Groq is primary. The default model is listed in Groq's current production models.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Local Ollama fallback (enabled unless OLLAMA_ENABLED=false).
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional legacy OpenAI provider (used only when GROQ_API_KEY is unset).
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5
# OPENAI_BASE_URL=

# Optional
GOOGLE_FACTCHECK_API_KEY=   # free: Google Fact Check Tools API (adds professional fact-checks as evidence)
NEWS_REFRESH_MIN=10         # background refresh interval
AI_RATE_LIMIT=20            # AI requests per IP per hour
EXTRA_TRUSTED_DOMAINS=      # comma-separated outlets to treat as established
